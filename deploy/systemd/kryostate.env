# Settings for kryostate.service. Read by systemd as KEY=value lines; a
# package upgrade keeps your copy. After a change:
#   systemctl restart kryostate

# The database. Custom collectors.json, rules.json and externals.json are
# read from the same directory.
KRYOSTATE_DB=/var/lib/kryostate/kryostate.db

# Where the web interface listens. It has no login of its own: keep it on
# 127.0.0.1 and put a proxy that asks people to sign in in front of it.
KRYOSTATE_ADDR=127.0.0.1:8099

# Any other "kryostate serve" flags, for example:
#   KRYOSTATE_OPTS=-trusted-origin https://cmdb.example.com -no-schedule
KRYOSTATE_OPTS=

# The agent "agent:" credentials sign with. This is the socket of
# kryostate-ssh-agent.service; point it elsewhere to use another agent the
# kryostate user can reach.
SSH_AUTH_SOCK=/run/kryostate-agent/agent.sock

# The age identity that opens "file:...age" credentials. Keep it outside
# /var/lib/kryostate, readable only by the kryostate user.
#KRYOSTATE_AGE_IDENTITY=/etc/kryostate/age-identity.txt
